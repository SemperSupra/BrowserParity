{
  "manifest_version": 3,
  "name": "R082 Synthetic Selected-Tab Read-Only Qualification",
  "version": "0.0.2",
  "permissions": [
    "nativeMessaging",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "worker.js"
  }
}
